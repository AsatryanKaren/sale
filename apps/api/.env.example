# Copy to apps/api/.env for local overrides. Nothing here is required locally:
# without DATABASE_URL the API keeps its data in apps/api/.data (PGlite).
PORT=8787

# Railway sets this when a Postgres service is linked to the app.
# DATABASE_URL=postgresql://user:password@host:5432/railway

# Public URL of the app, if the web app is ever served from another origin.
# APP_ORIGIN=https://saleradar.up.railway.app

# /api/dev/* helpers (e.g. ending a trial early). On by default outside production.
# DEMO_TOOLS=false
