{
  "name": "@saleradar/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests playwright --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:e2e",
    "test:unit": "playwright test --project=unit",
    "test:component": "playwright test --project=component",
    "test:e2e": "playwright test --project=e2e",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@saleradar/contracts": "workspace:*",
    "@tanstack/react-query": "^5.90.5",
    "antd": "^5.27.6",
    "dayjs": "^1.11.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "msw": "^2.11.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
